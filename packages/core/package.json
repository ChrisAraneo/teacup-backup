{
  "name": "@teacup-backup/core",
  "version": "0.5.4",
  "main": "dist/index.js",
  "description": "Teacup Backup is a simple Node.js script that finds, encrypts and creates backup of selected files.",
  "scripts": {
    "lint": "eslint \"src/**/*.{ts,json,js,mjs}\" \"*{.js,.mjs,.json,.ts}\" --fix",
    "format": "prettier --write \"**/*.{ts,json,js,mjs}\"",
    "chores": "npm run lint && npm run format",
    "test": "jest",
    "build": "tsup src/**/*.ts",
    "stryker": "npx stryker run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChrisAraneo/teacup-backup.git"
  },
  "keywords": [
    "backup",
    "file-encryption"
  ],
  "author": "Krzysztof Pająk (Chris Araneo) <chris.araneo@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ChrisAraneo/teacup-backup/issues"
  },
  "homepage": "https://github.com/ChrisAraneo/teacup-backup#readme",
  "dependencies": {
    "@chris.araneo/crypto": "^0.0.2",
    "@chris.araneo/file-system": "^0.0.32",
    "@chris.araneo/ftp": "^0.0.2",
    "@chris.araneo/logger": "^0.0.2",
    "basic-ftp": "^5.0.5",
    "crypto-js": "^4.2.0",
    "file-base64": "^1.0.0",
    "find": "^0.3.0",
    "lodash": "^4.17.21",
    "prompt-sync": "^4.2.0",
    "rxjs": "^7.8.1",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@stryker-mutator/jest-runner": "^8.7.1",
    "@stryker-mutator/typescript-checker": "^8.7.1"
  }
}

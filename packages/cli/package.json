{
  "name": "@teacup-backup/cli",
  "version": "0.5.4",
  "main": "dist/cli.js",
  "description": "Teacup Backup is a simple Node.js script that finds, encrypts and creates backup of selected files.",
  "license": "MIT",
  "bin": "dist/cli.js",
  "type": "module",
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "start:dev": "npm run build:dev && node dist/cli.js",
    "start:prod": "npm run build:prod && node dist/cli.prod.js",
    "lint": "eslint \"src/**/*.{ts,tsx,json}\" \"eslint.config.mjs\" \"tsconfig.json\" --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json}\"",
    "chores": "npm run lint && npm run format",
    "test": "ava",
    "build:dev": "tsc",
    "build:prod": "npm run build:dev && tsup dist/cli.js --format=esm --target=node16 --minify --out-dir=dist && node scripts/rename-output"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@chris.araneo/logger": "^0.0.2",
    "@reduxjs/toolkit": "^2.3.0",
    "@teacup-backup/core": "*",
    "ink": "^4.1.0",
    "meow": "^11.0.0",
    "react": "^18.2.0",
    "react-devtools-core": "^4.28.5",
    "react-redux": "^9.1.2",
    "redux-observable": "^3.0.0-rc.2",
    "rxjs": "^7.8.1"
  },
  "ava": {
    "extensions": {
      "ts": "module",
      "tsx": "module"
    },
    "nodeArguments": [
      "--import=tsimp"
    ]
  },
  "devDependencies": {
    "@types/sinon": "^17.0.3"
  }
}
